# Supadupa example environment.
# Copy to .env manually or run scripts/setup-compose.sh to generate one.

# local: loopback admin/API without public TLS
# vps: public Traefik edge with DNS and Let's Encrypt DNS-01
SUPADUPA_INSTALL_MODE=local

# Platform hosts. For VPS installs these should have DNS records pointing at the host.
SUPADUPA_ADMIN_HOST=admin.supadupa.test
SUPADUPA_API_HOST=api.supadupa.test
# Seeds the default project domain on a fresh/default control plane.
SUPADUPA_APPS_DOMAIN=apps.supadupa.test
# Optional explicit override if env should win over Admin UI defaults on restart.
SUPADUPA_PROJECT_DOMAIN=
SUPADUPA_ACME_EMAIL=admin@example.com
SUPADUPA_TLS_CERT_RESOLVER=letsencrypt
SUPADUPA_ACME_DNS_PROVIDER=cloudflare
SUPADUPA_ACME_DNS_DELAY_BEFORE_CHECK=10

# Local published ports for the admin/API containers.
# For VPS installs these can stay loopback because Traefik publishes 80/443/5432/6543.
SUPADUPA_ADMIN_ADDR=127.0.0.1:3000
SUPADUPA_API_ADDR=127.0.0.1:8080
VITE_API_BASE_URL=http://localhost:8080
SUPADUPA_CORS_ORIGINS=http://localhost:3000

# Required stable secrets. Replace before production use.
SUPADUPA_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SUPADUPA_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional first-run admin bootstrap. Remove after the first login if desired.
SUPADUPA_BOOTSTRAP_EMAIL=admin@example.test
SUPADUPA_BOOTSTRAP_PASSWORD=change-me

# Runtime paths. setup-compose.sh writes absolute paths for the current checkout.
SUPADUPA_RUNTIME_HOST_DIR=./runtime
SUPADUPA_RUNTIME_CONTAINER_DIR=/app/runtime
SUPADUPA_ROUTES_HOST_DIR=./runtime/routes
SUPADUPA_CERTS_HOST_DIR=./runtime/certs

# Compose provisioner.
SUPADUPA_PROVISIONER=compose
SUPADUPA_COMPOSE_APPLY=true

# Public edge bindings. Used only with docker compose --profile edge.
SUPADUPA_HTTP_ADDR=0.0.0.0:80
SUPADUPA_HTTPS_ADDR=0.0.0.0:443
SUPADUPA_POSTGRES_ADDR=0.0.0.0:5432
SUPADUPA_POOLER_ADDR=0.0.0.0:6543

# Cloudflare token for Traefik Let's Encrypt DNS-01.
# Required for public TLS when using the edge profile.
CLOUDFLARE_API_TOKEN=

# Route53 DNS-01 alternative. Set SUPADUPA_ACME_DNS_PROVIDER=route53.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_PROFILE=
AWS_SHARED_CREDENTIALS_FILE=
AWS_HOSTED_ZONE_ID=

# Optional durable off-host backup target. Required for hosted-grade recovery.
SUPADUPA_BACKUP_TARGET_NAME=
SUPADUPA_BACKUP_TARGET_ENDPOINT=
SUPADUPA_BACKUP_TARGET_REGION=auto
SUPADUPA_BACKUP_TARGET_BUCKET=
SUPADUPA_BACKUP_TARGET_PREFIX=supadupa
SUPADUPA_BACKUP_TARGET_ACCESS_KEY_ID=
SUPADUPA_BACKUP_TARGET_SECRET_ACCESS_KEY=
SUPADUPA_BACKUP_TARGET_FORCE_PATH_STYLE=false
SUPADUPA_BACKUP_TARGET_AUTO_TEST=false

# Production recovery guards. Leave false until a tested off-host target exists.
SUPADUPA_REQUIRE_RECOVERY_READY_TARGETS=false
SUPADUPA_REQUIRE_DURABLE_UPGRADE_BACKUP=false
