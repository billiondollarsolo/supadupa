# Supadupa example environment.
# Copy to .env manually or run scripts/setup-compose.sh to generate one.

# local: loopback admin/API without public TLS
# vps: public Traefik edge with DNS and Let's Encrypt DNS-01
SUPADUPA_INSTALL_MODE=local

# Platform hosts. For VPS installs these should have DNS records pointing at the host.
SUPADUPA_ADMIN_HOST=admin.supadupa.test
SUPADUPA_API_HOST=api.supadupa.test
# Seeds the default project domain on a fresh/default control plane.
SUPADUPA_APPS_DOMAIN=apps.supadupa.test
# Optional explicit override if env should win over Admin UI defaults on restart.
SUPADUPA_PROJECT_DOMAIN=
SUPADUPA_ACME_EMAIL=admin@example.com
SUPADUPA_TLS_CERT_RESOLVER=letsencrypt
SUPADUPA_ACME_DNS_PROVIDER=cloudflare
SUPADUPA_ACME_DNS_DELAY_BEFORE_CHECK=10

# Local published ports for the admin/API containers.
# For VPS installs these can stay loopback because Traefik publishes 80/443/5432/6543.
SUPADUPA_ADMIN_ADDR=127.0.0.1:3000
SUPADUPA_API_ADDR=127.0.0.1:8080
VITE_API_BASE_URL=http://localhost:8080
SUPADUPA_CORS_ORIGINS=http://localhost:3000

# Required stable secrets. These placeholder values are intentionally rejected at
# startup; generate real values or run scripts/setup-compose.sh.
# Example: openssl rand -hex 32
SUPADUPA_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SUPADUPA_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Local development escape hatch only. Do not set in production.
SUPADUPA_ALLOW_DEV_SECRETS=false

# Enables the current platform SSO compatibility adapter, which accepts a
# normalized signed JSON assertion rather than a full SAMLResponse XML document.
# Keep false for production until a real SAML XML parser/signature validator is configured.
SUPADUPA_ENABLE_PLATFORM_SSO_JSON_ADAPTER=false

# Optional first-run admin bootstrap. Remove after the first login if desired.
SUPADUPA_BOOTSTRAP_EMAIL=admin@example.test
SUPADUPA_BOOTSTRAP_PASSWORD=change-me

# Runtime paths. setup-compose.sh writes absolute paths for the current checkout.
# In Compose apply mode, the control plane writes under SUPADUPA_RUNTIME_CONTAINER_DIR
# while generated project bind mounts use SUPADUPA_PROJECT_HOST_ROOT on the host.
SUPADUPA_RUNTIME_HOST_DIR=./runtime
SUPADUPA_RUNTIME_CONTAINER_DIR=/app/runtime
SUPADUPA_ROUTES_HOST_DIR=./runtime/routes
SUPADUPA_CERTS_HOST_DIR=./runtime/certs
SUPADUPA_PROJECT_HOST_ROOT=./runtime/projects
SUPADUPA_CONTROL_PLANE_USER=10001:10001
# Optional override for the Docker socket proxy user. setup-compose.sh keeps
# Linux installs unprivileged by default and uses 0:0 on macOS Docker runtimes
# where the host socket group is not the group seen inside containers.
SUPADUPA_DOCKER_PROXY_USER=
# Host Docker socket group ID, used only by deploy/compose.apply.yaml's
# docker-socket-proxy service when Compose apply mode is enabled.
SUPADUPA_DOCKER_GID=0

# Compose provisioner.
SUPADUPA_PROVISIONER=compose
# Set true only when starting with deploy/compose.apply.yaml, which exposes a
# narrow Docker API proxy to the control plane.
SUPADUPA_COMPOSE_APPLY=false
# Legacy compatibility opt-in: mounts the host Docker socket into per-project Vector
# for Docker-log-based drains. Keep false unless you accept that daemon exposure.
SUPADUPA_PROJECT_DOCKER_LOGS=false

# Platform metadata database binding. Keep loopback unless the metadata
# database is intentionally exposed for local development or diagnostics.
SUPADUPA_META_DB_ADDR=127.0.0.1:15432

# Edge bindings. Used only with docker compose --profile edge.
SUPADUPA_HTTP_ADDR=127.0.0.1:80
SUPADUPA_HTTPS_ADDR=127.0.0.1:443
# Database/pooler ports bind to loopback by default. Set these to 0.0.0.0 only
# when external raw Postgres/pooler clients are required, and pair public binds
# with host/cloud firewall rules plus project DB allowlists. Actual reachability
# is still gated in software: every project's database is private until the
# platform master switch (Settings -> Database ingress) AND that project's own
# exposure (Config -> Network) are enabled, and Traefik only routes matched FQDNs.
SUPADUPA_POSTGRES_ADDR=127.0.0.1:5432
SUPADUPA_POOLER_ADDR=127.0.0.1:6543
# Optional comma-separated trusted client CIDRs for dashboard posture reporting
# when raw DB/pooler ports are intentionally public. Compose MVP does not enforce it.
SUPADUPA_DB_INGRESS_ALLOWED_CIDRS=

# Cloudflare token for Traefik Let's Encrypt DNS-01.
# Required for public TLS when using the edge profile.
CLOUDFLARE_API_TOKEN=

# Route53 DNS-01 alternative. Set SUPADUPA_ACME_DNS_PROVIDER=route53.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_PROFILE=
AWS_SHARED_CREDENTIALS_FILE=
AWS_HOSTED_ZONE_ID=

# Optional durable off-host backup target. Required for hosted-grade recovery.
SUPADUPA_BACKUP_TARGET_NAME=
SUPADUPA_BACKUP_TARGET_ENDPOINT=
SUPADUPA_BACKUP_TARGET_REGION=auto
SUPADUPA_BACKUP_TARGET_BUCKET=
SUPADUPA_BACKUP_TARGET_PREFIX=supadupa
SUPADUPA_BACKUP_TARGET_ACCESS_KEY_ID=
SUPADUPA_BACKUP_TARGET_SECRET_ACCESS_KEY=
SUPADUPA_BACKUP_TARGET_FORCE_PATH_STYLE=false
SUPADUPA_BACKUP_TARGET_AUTO_TEST=false
# Keep false unless intentionally testing against a local/private S3-compatible
# endpoint such as a disposable MinIO fixture.
SUPADUPA_ALLOW_UNSAFE_BACKUP_ENDPOINTS=false

# Production recovery guards. Leave false until a tested off-host target exists.
SUPADUPA_REQUIRE_RECOVERY_READY_TARGETS=false
SUPADUPA_REQUIRE_DURABLE_UPGRADE_BACKUP=false
