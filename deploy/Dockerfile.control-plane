FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/supadupa ./cmd/supadupa \
  && CGO_ENABLED=0 GOOS=linux go build -o /out/supadupa-cli ./cmd/supadupa-cli

FROM alpine:3.22

RUN apk add --no-cache ca-certificates docker-cli docker-cli-compose tzdata
WORKDIR /app
COPY --from=build /out/supadupa /usr/local/bin/supadupa
COPY --from=build /out/supadupa-cli /usr/local/bin/supadupa-cli
COPY --from=build /src/migrations ./migrations

ENV SUPADUPA_ADDR=:8080
ENV SUPADUPA_MIGRATIONS_DIR=/app/migrations
EXPOSE 8080

CMD ["supadupa"]
